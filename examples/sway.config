# hwatu + sway
# Drop these lines into ~/.config/sway/config

# Launch a browser window like you launch a terminal
bindsym $mod+b exec hwatu
bindsym $mod+Shift+b exec hwatu duckduckgo.com

# hwatu windows report app_id "dev.hwatu.hwatud"
assign [app_id="dev.hwatu.hwatud"] workspace number 2
# for_window [app_id="dev.hwatu.hwatud"] border pixel 2
