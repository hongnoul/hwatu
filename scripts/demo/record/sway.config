# Sway config for the hwatu demo stage (headless recording rig).
# Loaded by stage.sh inside a nested, invisible compositor.

output HEADLESS-1 resolution 1920x1080

# Video-friendly cosmetics: thin borders, no title bars.
default_border pixel 2
default_floating_border pixel 2
font pango:monospace 10
titlebar_border_thickness 0
titlebar_padding 1

# Colors tuned for a dark video theme.
client.focused          #7aa2f7 #1a1b26 #c0caf5 #7aa2f7 #7aa2f7
client.unfocused        #414868 #16161e #565f89 #414868 #414868

# hwatu windows tile; background ones must not grab focus.
for_window [app_id="dev.hwatu.hwatud"] border pixel 2
no_focus [app_id="hwatu-background"]

# The director terminal: kitty with remote control on a known socket.
exec kitty --config /dev/null \
  -o allow_remote_control=yes \
  -o font_size=18 \
  -o background='#16161e' -o foreground='#c0caf5' \
  -o cursor_shape=block -o cursor_blink_interval=0 \
  -o window_padding_width=12 \
  --listen-on unix:$HWATU_DEMO_KITTY_SOCK
